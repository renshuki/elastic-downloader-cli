#!/usr/bin/expect -f
# Drives the interactive prompts: pick first product, first architecture,
# type a version, and answer the confirmation.
# Usage: test-flow.exp <version> <y|n>
set timeout 120
set version [lindex $argv 0]
set confirm [lindex $argv 1]

spawn node index.js
expect "Select a product:"
send "\r"
expect "Select an architecture / package:"
send "\r"
expect "Type a version:"
send "$version\r"
expect "Are you sure to download"
send "$confirm\r"
expect {
    "Download cancelled." { exit 0 }
    "Download completed!" { exit 0 }
    "File not found" { exit 2 }
    "File already exists" { exit 3 }
    timeout { exit 4 }
    eof { exit 5 }
}
