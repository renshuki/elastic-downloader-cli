#!/usr/bin/expect -f
# Drives the interactive prompts: pick first product, first architecture,
# pick a version (search-list when available, manual input otherwise), and
# answer the confirmation.
# Usage: test-flow.exp <version> <y|n>
set timeout 120
set version [lindex $argv 0]
set confirm [lindex $argv 1]

spawn node index.js
expect "Select a product:"
send "\r"
expect "Select an architecture / package:"
send "\r"
expect {
    "Choose a version (type to filter):" { send "$version\r" }
    "Type a version:" { send "$version\r" }
}
# The extraction prompt only shows up for tar.gz / tgz / zip selections.
expect {
    "Extract the archive after the download?" {
        send "n\r"
        expect "Are you sure to download"
    }
    "Are you sure to download" {}
}
send "$confirm\r"
expect {
    "Download cancelled." { exit 0 }
    "Download completed!" { exit 0 }
    "File not found" { exit 2 }
    "File already exists" { exit 3 }
    timeout { exit 4 }
    eof { exit 5 }
}
